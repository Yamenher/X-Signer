<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorSurface"
    android:transitionGroup="true">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/Scroller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/BG"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="18dp"
            android:paddingVertical="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/TopTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingTop="?actionBarSize"
                android:gravity="center_vertical"
                android:text="Keystore credentials"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/product_sans_regular"
                android:textColor="?colorPrimary" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/AliasTIP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:paddingVertical="5dp"
                android:hint="Key alias"
                app:placeholderTextColor="?colorOutline"
                app:hintEnabled="true"
                app:hintAnimationEnabled="true"
                app:placeholderText="E.g : Company name"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/AliasE"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="20dp"
                    android:paddingTop="18dp"
                    android:paddingRight="20dp"
                    android:paddingBottom="18dp"
                    android:textSize="16sp"
                    android:imeOptions="actionNext"
                    android:focusable="true"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/AliasPassTIP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:hint="@string/stringKeyPass"
                app:hintEnabled="true"
                app:hintAnimationEnabled="true"
                app:placeholderText="Password for the alias"
                app:placeholderTextColor="?colorOutline"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/AliasPassE"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="18dp"
                    android:textSize="16sp"
                    android:focusable="true"
                    android:textColor="@color/md_theme_textMain"
                    android:imeOptions="actionNext"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/KeyStorePassTIP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:hint="@string/stringKeyStore"
                app:hintEnabled="true"
                app:hintAnimationEnabled="true"
                app:placeholderText="Password for the whole keystore"
                app:placeholderTextColor="?colorOutline"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/KeyStorePassE"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="20dp"
                    android:paddingTop="18dp"
                    android:paddingRight="20dp"
                    android:paddingBottom="18dp"
                    android:textSize="16sp"
                    android:focusable="true"
                    android:imeOptions="actionNext"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/MiddleTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:padding="8dp"
                android:gravity="center_vertical"
                android:text="Keystore details"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/product_sans_regular"
                android:textColor="?colorPrimary" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/KeyTypeTIP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:hint="@string/stringKeyType"
                app:hintEnabled="true"
                app:hintAnimationEnabled="true"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <AutoCompleteTextView
                    android:id="@+id/KeyTypeE"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="20dp"
                    android:paddingTop="18dp"
                    android:paddingRight="20dp"
                    android:paddingBottom="18dp"
                    android:textSize="16sp"
                    android:inputType="none"
                    android:textColor="@color/md_theme_textMain"
                    android:imeOptions="actionNext"
                    android:singleLine="true"
                    app:simpleItems="@array/keyTypes"
                    style="@style/Widget.Material3.AutoCompleteTextView.OutlinedBox" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/KeySizeTIP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:hint="@string/stringKeySize"
                app:hintEnabled="true"
                app:hintAnimationEnabled="true"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <AutoCompleteTextView
                    android:id="@+id/KeySizeE"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="20dp"
                    android:paddingTop="18dp"
                    android:paddingRight="20dp"
                    android:paddingBottom="18dp"
                    android:textSize="16sp"
                    android:inputType="none"
                    android:textColor="@color/md_theme_textMain"
                    android:imeOptions="actionNext"
                    android:singleLine="true"
                    app:simpleItems="@array/keySizes"
                    style="@style/Widget.Material3.AutoCompleteTextView.OutlinedBox" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/KeyValidityTIP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:hint="@string/stringKeyValidity"
                app:hintEnabled="true"
                app:hintAnimationEnabled="true"
                app:placeholderText="Validity time in years"
                app:placeholderTextColor="?colorOutline"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/KeyValidityE"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="20dp"
                    android:paddingTop="18dp"
                    android:paddingRight="20dp"
                    android:paddingBottom="18dp"
                    android:textSize="16sp"
                    android:inputType="numberSigned"
                    android:focusable="true"
                    android:textColor="@color/md_theme_textMain"
                    android:imeOptions="actionNext"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/TypeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="8dp"
                android:gravity="center_vertical"
                android:text="Certificate details"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/product_sans_regular"
                android:textColor="?colorPrimary" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/NameTIP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:hint="@string/stringNameDetails"
                app:hintEnabled="true"
                app:hintAnimationEnabled="true"
                app:placeholderText="E.g : Joey Kyles"
                app:placeholderTextColor="?colorOutline"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/NameE"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="20dp"
                    android:paddingTop="18dp"
                    android:paddingRight="20dp"
                    android:paddingBottom="18dp"
                    android:textSize="16sp"
                    android:focusable="true"
                    android:textColor="@color/md_theme_textMain"
                    android:imeOptions="actionNext"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/OrganizationContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/OrUnitTIP"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_weight="1"
                    android:hint="@string/stringOrganizationalUnit"
                    app:hintEnabled="true"
                    app:hintAnimationEnabled="true"
                    app:placeholderText="Idk about this :P"
                    app:placeholderTextColor="?colorOutline"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/OrUnitE"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="20dp"
                        android:paddingTop="18dp"
                        android:paddingRight="20dp"
                        android:paddingBottom="18dp"
                        android:textSize="16sp"
                        android:focusable="true"
                        android:textColor="@color/md_theme_textMain"
                        android:imeOptions="actionNext"
                        android:singleLine="true" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/OrNameTIP"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_weight="1"
                    android:hint="@string/stringOrganizationName"
                    app:hintEnabled="true"
                    app:hintAnimationEnabled="true"
                    app:placeholderText="E.g Google LLC"
                    app:placeholderTextColor="?colorOutline"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/OrNameE"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="20dp"
                        android:paddingTop="18dp"
                        android:paddingRight="20dp"
                        android:paddingBottom="18dp"
                        android:textSize="16sp"
                        android:focusable="true"
                        android:textColor="@color/md_theme_textMain"
                        android:imeOptions="actionNext"
                        android:singleLine="true" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/LocationContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/CityTIP"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_weight="1"
                    android:hint="@string/stringCity"
                    app:hintEnabled="true"
                    app:hintAnimationEnabled="true"
                    app:placeholderText="E.g : New York"
                    app:placeholderTextColor="?colorOutline"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/CityE"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="20dp"
                        android:paddingTop="18dp"
                        android:paddingRight="20dp"
                        android:paddingBottom="18dp"
                        android:textSize="16sp"
                        android:focusable="true"
                        android:textColor="@color/md_theme_textMain"
                        android:imeOptions="actionNext"
                        android:singleLine="true" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/StateTIP"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_weight="1"
                    android:hint="@string/stringState"
                    app:hintEnabled="true"
                    app:hintAnimationEnabled="true"
                    app:placeholderText="E.g : California"
                    app:placeholderTextColor="?colorOutline"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/StateE"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="20dp"
                        android:paddingTop="18dp"
                        android:paddingRight="20dp"
                        android:paddingBottom="18dp"
                        android:textSize="16sp"
                        android:focusable="true"
                        android:textColor="@color/md_theme_textMain"
                        android:imeOptions="actionNext"
                        android:singleLine="true" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/CountryTIP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:hint="@string/stringCountry"
                app:hintEnabled="true"
                app:hintAnimationEnabled="true"
                app:placeholderText="E.g : France = FR"
                app:placeholderTextColor="?colorOutline"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/CountryE"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="20dp"
                    android:paddingTop="18dp"
                    android:paddingRight="20dp"
                    android:paddingBottom="18dp"
                    android:textSize="16sp"
                    android:focusable="true"
                    android:textColor="@color/md_theme_textMain"
                    android:imeOptions="actionDone"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/CreateButton"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:padding="8dp"
        android:layout_gravity="bottom|center_horizontal"
        android:gravity="center_horizontal|center_vertical"
        android:text="Create"
        android:textSize="16sp"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Button"
        android:letterSpacing="0.0"
        app:cornerRadius="100dp"
        app:textAllCaps="false"
        style="@style/Widget.Material3.Button" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$Behavior"
        app:liftOnScroll="true"
        style="@style/Widget.Material3.AppBarLayout">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:liftOnScrollColor="?colorOnSurfaceInverse"
            app:layout_collapseMode="pin" />

    </com.google.android.material.appbar.AppBarLayout>

    <com.github.mmin18.widget.RealtimeBlurView
        android:id="@+id/blurLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible"
        app:realtimeBlurRadius="20dp"
        app:realtimeOverlayColor="#11BDBDBD" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>